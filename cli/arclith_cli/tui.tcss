$background: #090d12;
$surface: #10161d;
$surface-lighten-1: #151d26;
$boost: #202936;
$primary: #9383ff;
$primary-lighten-1: #aa9dff;
$primary-darken-1: #7563e8;
$success: #55d8ae;
$warning: #f0bc58;
$error: #ff6b78;
$text: #edf4fb;
$text-muted: #8e9cab;
$border: #27313d;

Screen {
    background: $background;
    color: $text;
}

WelcomeScreen, ProjectPickerScreen {
    align-horizontal: center;
}

Header {
    background: $surface;
    color: $text;
}

Footer {
    background: $surface-lighten-1;
    color: $text-muted;
}

Button {
    min-width: 16;
    height: 3;
    border: none;
    background: $boost;
    color: $text;
}

Button:hover {
    background: $primary-darken-1;
}

Button.-primary {
    background: $primary;
    color: $background;
}

Button.-success {
    background: $success;
    color: $background;
}

Button.-error {
    background: $error;
    color: $background;
}

Input {
    height: 3;
    border: tall $border;
    background: $surface;
    color: $text;
}

Input:focus {
    border: tall $primary;
}

Select {
    height: auto;
    background: transparent;
    color: $text;
}

Select > SelectCurrent {
    border: tall $border;
    background: $surface;
    color: $text;
}

Select:focus > SelectCurrent {
    border: tall $primary;
    background: $surface-lighten-1;
}

SelectCurrent.-has-value Static#label {
    color: $text;
}

SelectCurrent .arrow {
    color: $text-muted;
}

Select > SelectOverlay {
    border: tall $primary;
    background: $surface-lighten-1;
    color: $text;
}

Select > SelectOverlay > .option-list--option {
    background: $surface-lighten-1;
    color: $text;
}

Select > SelectOverlay > .option-list--option-highlighted {
    background: $primary;
    color: $background;
    text-style: bold;
}

Select > SelectOverlay > .option-list--option-hover {
    background: $boost;
    color: $text;
}

.section-title {
    color: $text-muted;
    text-style: bold;
    margin-bottom: 1;
}

.eyebrow {
    color: $primary-lighten-1;
    text-style: bold;
    margin-bottom: 1;
}

.lead {
    color: $text-muted;
    margin-bottom: 1;
}

.field-label {
    color: $text-muted;
    margin-top: 1;
}

.field-help {
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

.decision-note {
    height: auto;
    padding: 1 2;
    margin-top: 1;
    background: $surface;
    border-left: thick $primary;
    color: $text-muted;
}

.content-title {
    margin-top: 1;
    margin-bottom: 1;
    text-style: bold;
}

.error-message {
    min-height: 1;
    color: $error;
    margin-top: 1;
}

.action-row {
    height: 4;
    align-horizontal: right;
    margin-top: 1;
}

.action-row Button {
    margin-left: 1;
}

#welcome-shell {
    width: 62;
    height: auto;
    max-height: 30;
    margin: 4 0;
    padding: 2 5;
    background: $surface;
    border: round $border;
    align-horizontal: center;
}

#welcome-mark {
    width: 7;
    height: 3;
    content-align: center middle;
    background: $primary;
    color: $background;
    text-style: bold;
    margin-bottom: 1;
}

#welcome-title {
    width: 100%;
    text-align: center;
    text-style: bold;
}

#welcome-copy {
    width: 100%;
    color: $text-muted;
    text-align: center;
    margin: 1 0 2 0;
}

#welcome-shell Input {
    width: 100%;
}

#welcome-shell Button {
    margin: 1 0;
}

#wizard-shell, #dashboard-shell {
    height: 1fr;
}

#wizard-sidebar, #project-sidebar {
    width: 25;
    min-width: 22;
    padding: 2 1;
    background: $surface;
    border-right: tall $border;
}

.wizard-step {
    height: 3;
    padding: 1;
    color: $text-muted;
}

.wizard-step.is-active {
    background: $boost;
    color: $primary-lighten-1;
    text-style: bold;
}

#wizard-note {
    dock: bottom;
    color: $text-muted;
    padding: 1;
}

#wizard-main {
    width: 1fr;
    min-width: 42;
    height: 1fr;
}

#wizard-form {
    width: 100%;
    height: 1fr;
    padding: 2 3;
}

#wizard-title, #project-title {
    height: auto;
    text-style: bold;
    color: $text;
}

#wizard-title {
    text-style: bold;
}

.form-field {
    height: auto;
}

.wizard-page {
    width: 100%;
    height: auto;
}

#review-plan {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#wizard-actions {
    width: 100%;
    height: 4;
    padding: 0 3;
    margin-top: 0;
}

#creation-progress {
    margin: 0 3;
}

#plan-panel, #project-plan {
    width: 40;
    min-width: 32;
    padding: 2;
    background: $surface;
    border-left: tall $border;
}

#plan-preview {
    color: $text-muted;
}

#project-brand {
    height: 3;
    padding: 1;
    color: $primary-lighten-1;
    text-style: bold;
    margin-bottom: 2;
}

#project-sidebar Button {
    width: 100%;
    margin-bottom: 1;
}

#project-location {
    dock: bottom;
    padding: 1;
    color: $text-muted;
}

#project-content {
    width: 1fr;
    min-width: 48;
    padding: 2 3;
}

#project-summary {
    height: auto;
}

#project-metrics {
    height: 6;
    margin: 1 0;
}

.metric {
    width: 1fr;
    height: 5;
    padding: 1 2;
    margin-right: 1;
    background: $surface;
    border: round $border;
}

#runtime-toolbar {
    height: 4;
}

#project-actions {
    height: 4;
    margin-bottom: 1;
}

#project-actions Button {
    width: 1fr;
    margin-right: 1;
}

#runtime-mode {
    width: 1fr;
    margin-right: 1;
}

#runtime-toolbar Button {
    margin-left: 1;
}

#runtime-status {
    height: 2;
    padding-left: 1;
    color: $text-muted;
}

#runtime-log {
    height: 1fr;
    min-height: 12;
    padding: 1;
    background: $surface;
    border: round $border;
}

#project-details, #project-doctor {
    height: auto;
    color: $text-muted;
}

#picker-shell {
    width: 96;
    max-width: 100%;
    height: 1fr;
    margin: 1 0;
    padding: 2 3;
    background: $surface;
    border: round $border;
}

#picker-toolbar {
    height: 4;
    margin-top: 1;
}

#picker-toolbar Button {
    margin-right: 1;
}

#picker-tree {
    height: 1fr;
    min-height: 8;
    padding: 1;
    background: $background;
    border: round $border;
}

#picker-tree:focus {
    border: round $primary;
}

#picker-status {
    height: auto;
    min-height: 2;
    margin-top: 1;
    color: $text-muted;
}

#picker-actions {
    margin-top: 0;
}

#adapter-shell {
    height: 1fr;
}

#adapter-sidebar {
    width: 28;
    min-width: 24;
    padding: 2 1;
    background: $surface;
    border-right: tall $border;
}

#adapter-brand {
    height: 3;
    padding: 1;
    color: $primary-lighten-1;
    text-style: bold;
}

#adapter-steps {
    height: auto;
    margin: 2 1;
    color: $text-muted;
}

#adapter-installed {
    height: 1fr;
    padding: 1;
    color: $text-muted;
    overflow-y: auto;
}

#adapter-main {
    width: 1fr;
    min-width: 48;
    height: 1fr;
}

#adapter-form {
    width: 100%;
    height: 1fr;
    padding: 2 4;
}

#adapter-title {
    height: auto;
    text-style: bold;
}

#adapter-parameters {
    width: 100%;
    height: auto;
}

.adapter-parameter {
    width: 100%;
    margin-top: 1;
}

.adapter-parameter Switch {
    margin-top: 1;
}

#adapter-activation-field {
    height: auto;
    min-height: 5;
    margin-top: 1;
    padding: 0 1;
    background: $surface;
    border-left: thick $primary;
}

#adapter-activation-copy {
    width: 1fr;
    height: auto;
}

#adapter-activate {
    width: 10;
    margin-top: 1;
}

#adapter-command {
    height: auto;
    min-height: 4;
    padding: 1 2;
    background: $surface;
    border: round $border;
    color: $text-muted;
}

#adapter-conflict {
    height: auto;
    margin-top: 1;
    padding: 1 2;
    background: $surface;
    border-left: thick $warning;
}

#adapter-loading {
    height: 3;
    color: $primary;
}

#adapter-actions {
    width: 100%;
    height: 4;
    padding: 0 4;
    margin-top: 0;
}
